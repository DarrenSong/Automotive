; bootloader scatter for WarShip F103
; bootloader: 0x08000000 size 0x8000 (32KB)
; app_boot  : 0x08008000

LR_IROM1 0x08000000 0x00008000  {
  ER_IROM1 0x08000000 0x00008000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00010000  {
   .ANY (+RW +ZI)
  }
}
